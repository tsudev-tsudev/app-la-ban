          "sql": "CREATE TABLE IF NOT EXISTS \"diem\" (\"id\" TEXT NOT NULL, \"ten\" TEXT NOT NULL, \"vi_do\" REAL NOT NULL CHECK(\"vi_do\" BETWEEN -90.0 AND 90.0), \"kinh_do\" REAL NOT NULL CHECK(\"kinh_do\" BETWEEN -180.0 AND 180.0), \"cao_do\" REAL NULL, \"ghi_chu\" TEXT NOT NULL DEFAULT '', \"tao_luc\" INTEGER NOT NULL, \"sua_luc\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
