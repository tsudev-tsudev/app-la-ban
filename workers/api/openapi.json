{
  "openapi": "3.1.0",
  "info": {
    "title": "La bàn API",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://compass-api.tsudev.com"
    }
  ],
  "paths": {
    "/v1/device/attest": {
      "post": {
        "summary": "Xác minh lại thiết bị (Play Integrity mới, thách thức mới) - cập nhật mức tin cậy",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "mucTin": {
                      "type": "string",
                      "enum": [
                        "strong",
                        "device",
                        "basic",
                        "failed",
                        "unverified"
                      ]
                    }
                  },
                  "required": [
                    "mucTin"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        },
        "security": [
          {
            "phienThietBi": [],
            "kyThietBi": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "thachThuc": {
                    "type": "string"
                  },
                  "chuKy": {
                    "type": "string",
                    "minLength": 80,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "goi": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                  },
                  "integrityToken": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 16,
                        "maxLength": 12000,
                        "pattern": "^[A-Za-z0-9_.=-]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "thachThuc",
                  "chuKy",
                  "goi",
                  "integrityToken"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/device/challenge": {
      "post": {
        "summary": "Cấp thách thức dùng một lần (5 phút) cho đăng ký / xác minh lại thiết bị",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "thachThuc": {
                      "type": "string"
                    },
                    "hetHanMs": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "thachThuc",
                    "hetHanMs"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "installationId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "installationId"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/device/me": {
      "get": {
        "summary": "Trạng thái + mức tin cậy của thiết bị đang đăng nhập",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "thietBiId": {
                      "type": "string"
                    },
                    "trangThai": {
                      "type": "string",
                      "enum": [
                        "clean",
                        "suspicious",
                        "restricted",
                        "banned"
                      ]
                    },
                    "mucTin": {
                      "type": "string",
                      "enum": [
                        "strong",
                        "device",
                        "basic",
                        "failed",
                        "unverified"
                      ]
                    }
                  },
                  "required": [
                    "thietBiId",
                    "trangThai",
                    "mucTin"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        },
        "security": [
          {
            "phienThietBi": [],
            "kyThietBi": []
          }
        ]
      }
    },
    "/v1/device/register": {
      "post": {
        "summary": "Đăng ký thiết bị: khoá P-256 phần cứng + chữ ký thách thức + Play Integrity -> phiên",
        "responses": {
          "201": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "thietBiId": {
                      "type": "string"
                    },
                    "trangThai": {
                      "type": "string",
                      "enum": [
                        "clean",
                        "suspicious",
                        "restricted",
                        "banned"
                      ]
                    },
                    "mucTin": {
                      "type": "string",
                      "enum": [
                        "strong",
                        "device",
                        "basic",
                        "failed",
                        "unverified"
                      ]
                    },
                    "phien": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string"
                        },
                        "hetHan": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "refreshToken": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "accessToken",
                        "hetHan",
                        "refreshToken"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "thietBiId",
                    "trangThai",
                    "mucTin",
                    "phien"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "installationId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "khoaCongKhai": {
                    "type": "string",
                    "minLength": 100,
                    "maxLength": 140,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "thachThuc": {
                    "type": "string"
                  },
                  "chuKy": {
                    "type": "string",
                    "minLength": 80,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "nenTang": {
                    "type": "string",
                    "enum": [
                      "android",
                      "ios"
                    ]
                  },
                  "goi": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                  },
                  "integrityToken": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 16,
                        "maxLength": 12000,
                        "pattern": "^[A-Za-z0-9_.=-]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "thongTin": {
                    "type": "object",
                    "properties": {
                      "heDieuHanh": {
                        "type": "string",
                        "maxLength": 32
                      },
                      "model": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "phienBan": {
                        "type": "string",
                        "maxLength": 32
                      },
                      "build": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000000
                      },
                      "ngonNgu": {
                        "type": "string",
                        "maxLength": 16
                      }
                    },
                    "required": [
                      "heDieuHanh",
                      "model",
                      "phienBan",
                      "build",
                      "ngonNgu"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "installationId",
                  "khoaCongKhai",
                  "thachThuc",
                  "chuKy",
                  "nenTang",
                  "goi",
                  "integrityToken",
                  "thongTin"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "post": {
        "summary": "Lô sự kiện bảo mật (<= 50) đã ký bằng khoá thiết bị -> Threat Engine (chống trùng event_id)",
        "responses": {
          "202": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "nhan": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "trung": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "nhan",
                    "trung"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        },
        "security": [
          {
            "phienThietBi": [],
            "kyThietBi": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "events": {
                    "minItems": 1,
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "event_id": {
                          "type": "string"
                        },
                        "ts": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        },
                        "type": {
                          "type": "string",
                          "pattern": "^[A-Z][A-Z0-9_]{2,47}$"
                        },
                        "severity": {
                          "type": "string",
                          "enum": [
                            "info",
                            "low",
                            "medium",
                            "high",
                            "critical"
                          ]
                        },
                        "signals": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{0,39}$"
                          },
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "string",
                                "maxLength": 128
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "app": {
                          "type": "object",
                          "properties": {
                            "version": {
                              "type": "string",
                              "pattern": "^\\d+\\.\\d+\\.\\d+$"
                            },
                            "build": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 1000000000
                            },
                            "install_source": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "maxLength": 64
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "version",
                            "build",
                            "install_source"
                          ],
                          "additionalProperties": false
                        },
                        "env": {
                          "type": "object",
                          "properties": {
                            "os": {
                              "type": "string",
                              "enum": [
                                "android",
                                "ios"
                              ]
                            },
                            "os_ver": {
                              "type": "string",
                              "maxLength": 32
                            },
                            "model": {
                              "type": "string",
                              "maxLength": 64
                            },
                            "emulator": {
                              "type": "boolean"
                            },
                            "root": {
                              "type": "string",
                              "enum": [
                                "no",
                                "suspected",
                                "confirmed"
                              ]
                            }
                          },
                          "required": [
                            "os",
                            "os_ver",
                            "model",
                            "emulator",
                            "root"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "event_id",
                        "ts",
                        "type",
                        "severity",
                        "signals",
                        "app",
                        "env"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "events"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Tình trạng dịch vụ và mã build đang phục vụ",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "moiTruong": {
                      "type": "string"
                    },
                    "build": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "moiTruong",
                    "build"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        }
      }
    },
    "/v1/khieu-nai": {
      "post": {
        "summary": "Khiếu nại hạn chế thiết bị từ landing (mã REF + Turnstile)",
        "responses": {
          "201": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 24
                  },
                  "noiDung": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 2000
                  },
                  "lienHe": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": ""
                      },
                      {
                        "type": "string",
                        "maxLength": 254,
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                      }
                    ]
                  },
                  "ngonNgu": {
                    "type": "string",
                    "enum": [
                      "vi",
                      "en"
                    ]
                  },
                  "turnstile": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "required": [
                  "ref",
                  "noiDung",
                  "ngonNgu",
                  "turnstile"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/session/refresh": {
      "post": {
        "summary": "Xoay refresh token (ký bằng khoá thiết bị); dùng lại token đã xoay -> thu hồi cả chuỗi",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "mucTin": {
                      "type": "string",
                      "enum": [
                        "strong",
                        "device",
                        "basic",
                        "failed",
                        "unverified"
                      ]
                    },
                    "phien": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string"
                        },
                        "hetHan": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "refreshToken": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "accessToken",
                        "hetHan",
                        "refreshToken"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "mucTin",
                    "phien"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "minLength": 43,
                    "maxLength": 43,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "ts": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "nonce": {
                    "type": "string"
                  },
                  "chuKy": {
                    "type": "string",
                    "minLength": 80,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                },
                "required": [
                  "refreshToken",
                  "ts",
                  "nonce",
                  "chuKy"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Trạng thái thiết bị (kể cả bị cấm) + mã REF khiếu nại + bản APK mới nhất",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "trangThai": {
                      "type": "string",
                      "enum": [
                        "clean",
                        "suspicious",
                        "restricted",
                        "banned"
                      ]
                    },
                    "mucTin": {
                      "type": "string"
                    },
                    "ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "banMoi": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "phienBan": {
                              "type": "string"
                            },
                            "maPhienBan": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "phienBan",
                            "maPhienBan"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "trangThai",
                    "mucTin",
                    "ref",
                    "banMoi"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        },
        "security": [
          {
            "phienThietBi": [],
            "kyThietBi": []
          }
        ]
      }
    },
    "/v1/web/signals": {
      "post": {
        "summary": "Tín hiệu khiên web (công cụ nhà phát triển) từ landing / admin -> Threat Engine theo IP",
        "responses": {
          "202": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "trang": {
                    "type": "string",
                    "enum": [
                      "landing",
                      "admin"
                    ]
                  },
                  "loai": {
                    "type": "string",
                    "enum": [
                      "devtools"
                    ]
                  },
                  "duongDan": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^\\/[A-Za-z0-9/._-]*$"
                  },
                  "tinHieu": {
                    "type": "object",
                    "properties": {
                      "kich_thuoc": {
                        "type": "boolean"
                      },
                      "diem": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "phim": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      },
                      "menu": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      }
                    },
                    "required": [
                      "kich_thuoc",
                      "diem",
                      "phim",
                      "menu"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "trang",
                  "loai",
                  "duongDan",
                  "tinHieu"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VanDe": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "phienThietBi": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT ES256"
      },
      "kyThietBi": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Signature",
        "description": "ECDSA P-256 (DER, base64url) bằng khoá thiết bị trên \"METHOD\\nPATH\\nSORTED_QUERY\\nSHA256_HEX(BODY)\\nX-Timestamp\\nX-Nonce\"; kèm X-Timestamp (ms, lệch <= 60 s), X-Nonce (dùng 1 lần), X-Device-Id (tuỳ chọn)."
      }
    }
  }
}
