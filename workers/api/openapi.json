{
  "openapi": "3.1.0",
  "info": {
    "title": "La bàn API",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://compass-api.tsudev.com"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Tình trạng dịch vụ và mã build đang phục vụ",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "moiTruong": {
                      "type": "string"
                    },
                    "build": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "moiTruong",
                    "build"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Lỗi RFC 7807",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/VanDe"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VanDe": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "additionalProperties": false
      }
    }
  }
}
