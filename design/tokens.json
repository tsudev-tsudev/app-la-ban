{
  "$meta": {
    "name": "La bàn design tokens",
    "source": "Spec §2.1 - nguồn DUY NHẤT; sinh Dart + CSS bằng: node tools/build/tokens.mjs",
    "note": "primary (cyan) KHÔNG dùng làm màu chữ trên nền sáng; chữ nhấn dùng primaryDeep. Biến thể *Strong là bản an toàn cho chữ."
  },
  "color": {
    "light": {
      "primary": "#00E5FF",
      "primaryDeep": "#1A56DB",
      "secondary": "#2962FF",
      "accent": "#FF6D00",
      "accentStrong": "#B94A00",
      "bg": "#F8FAFC",
      "surface": "#F0F4F8",
      "surfaceRaised": "#FFFFFF",
      "outline": "#CBD5E1",
      "outlineStrong": "#64748B",
      "text": "#0B1220",
      "textMuted": "#475569",
      "onPrimary": "#0B1220",
      "onPrimaryDeep": "#FFFFFF",
      "onAccent": "#0B1220",
      "danger": "#E53935",
      "dangerStrong": "#C62828",
      "onDanger": "#FFFFFF",
      "warning": "#FFB300",
      "warningStrong": "#8A5A00",
      "onWarning": "#0B1220",
      "success": "#00C853",
      "successStrong": "#007A34",
      "onSuccess": "#0B1220",
      "scrim": "#990B1220"
    },
    "dark": {
      "primary": "#00E5FF",
      "primaryDeep": "#4C8DFF",
      "secondary": "#5C8BFF",
      "accent": "#FF8A3D",
      "accentStrong": "#FF8A3D",
      "bg": "#0B1220",
      "surface": "#131C2E",
      "surfaceRaised": "#1B2740",
      "outline": "#334155",
      "outlineStrong": "#7C8BA1",
      "text": "#E8EEF7",
      "textMuted": "#94A3B8",
      "onPrimary": "#0B1220",
      "onPrimaryDeep": "#0B1220",
      "onAccent": "#0B1220",
      "danger": "#FF6B66",
      "dangerStrong": "#FF6B66",
      "onDanger": "#0B1220",
      "warning": "#FFCA4D",
      "warningStrong": "#FFCA4D",
      "onWarning": "#0B1220",
      "success": "#3DDC84",
      "successStrong": "#3DDC84",
      "onSuccess": "#0B1220",
      "scrim": "#B3000000"
    }
  },
  "contrast": [
    { "fg": "text", "bg": "bg", "min": 4.5 },
    { "fg": "text", "bg": "surface", "min": 4.5 },
    { "fg": "text", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "textMuted", "bg": "bg", "min": 4.5 },
    { "fg": "textMuted", "bg": "surface", "min": 4.5 },
    { "fg": "textMuted", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "primaryDeep", "bg": "bg", "min": 4.5 },
    { "fg": "primaryDeep", "bg": "surface", "min": 4.5 },
    { "fg": "primaryDeep", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "accentStrong", "bg": "bg", "min": 4.5 },
    { "fg": "accentStrong", "bg": "surface", "min": 4.5 },
    { "fg": "dangerStrong", "bg": "bg", "min": 4.5 },
    { "fg": "dangerStrong", "bg": "surface", "min": 4.5 },
    { "fg": "warningStrong", "bg": "bg", "min": 4.5 },
    { "fg": "warningStrong", "bg": "surface", "min": 4.5 },
    { "fg": "successStrong", "bg": "bg", "min": 4.5 },
    { "fg": "successStrong", "bg": "surface", "min": 4.5 },
    { "fg": "onPrimary", "bg": "primary", "min": 4.5 },
    { "fg": "onPrimaryDeep", "bg": "primaryDeep", "min": 4.5 },
    { "fg": "onAccent", "bg": "accent", "min": 4.5 },
    { "fg": "onDanger", "bg": "dangerStrong", "min": 4.5 },
    { "fg": "onWarning", "bg": "warning", "min": 4.5 },
    { "fg": "onSuccess", "bg": "success", "min": 4.5 },
    { "fg": "outlineStrong", "bg": "bg", "min": 3 },
    { "fg": "outlineStrong", "bg": "surface", "min": 3 },
    { "fg": "danger", "bg": "bg", "min": 3 },
    { "fg": "secondary", "bg": "bg", "min": 3 }
  ],
  "spacing": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24 },
  "shadow": {
    "light": {
      "sm": [{ "x": 0, "y": 1, "blur": 3, "spread": 0, "color": "#1F0B1220" }],
      "md": [
        { "x": 0, "y": 4, "blur": 12, "spread": -2, "color": "#260B1220" },
        { "x": -2, "y": -2, "blur": 8, "spread": 0, "color": "#B3FFFFFF" }
      ],
      "lg": [
        { "x": 0, "y": 12, "blur": 32, "spread": -6, "color": "#330B1220" },
        { "x": -4, "y": -4, "blur": 16, "spread": 0, "color": "#CCFFFFFF" }
      ]
    },
    "dark": {
      "sm": [{ "x": 0, "y": 1, "blur": 3, "spread": 0, "color": "#66000000" }],
      "md": [
        { "x": 0, "y": 4, "blur": 12, "spread": -2, "color": "#80000000" },
        { "x": -1, "y": -1, "blur": 6, "spread": 0, "color": "#14FFFFFF" }
      ],
      "lg": [
        { "x": 0, "y": 12, "blur": 32, "spread": -6, "color": "#99000000" },
        { "x": -2, "y": -2, "blur": 12, "spread": 0, "color": "#1AFFFFFF" }
      ]
    }
  },
  "glass": {
    "blur": 16,
    "light": { "fill": "#B8FFFFFF", "border": "#99FFFFFF" },
    "dark": { "fill": "#99131C2E", "border": "#33FFFFFF" }
  },
  "font": {
    "family": "BeVietnamPro",
    "cssFamily": "\"Be Vietnam Pro\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
  },
  "type": {
    "display": { "size": 48, "height": 56, "weight": 700 },
    "headline": { "size": 28, "height": 36, "weight": 700 },
    "title": { "size": 20, "height": 28, "weight": 600 },
    "body": { "size": 16, "height": 24, "weight": 400 },
    "bodySmall": { "size": 14, "height": 20, "weight": 400 },
    "label": { "size": 14, "height": 20, "weight": 600 },
    "caption": { "size": 12, "height": 16, "weight": 500 },
    "telemetry": { "size": 32, "height": 40, "weight": 600, "tabular": true },
    "telemetryLarge": { "size": 56, "height": 64, "weight": 700, "tabular": true }
  },
  "breakpoint": { "medium": 600, "expanded": 840 },
  "motion": { "fast": 120, "normal": 200, "slow": 320, "splash": 900 }
}
