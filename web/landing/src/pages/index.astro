---
// Trang tạm "Sắp ra mắt" - nội dung đầy đủ ở phase R1.
import '../../../../design/gen/tokens.css';
const tieuDe = 'La bàn - Sắp ra mắt';
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDe}</title>
    <meta name="description" content="Ứng dụng La bàn của TsuDev - sắp ra mắt trên Google Play và App Store." />
    <meta name="theme-color" content="#F8FAFC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tieuDe} />
    <meta property="og:description" content="La bàn thông minh - chính xác, riêng tư. Smart Compass for Android & iOS." />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main>
      <h1>La bàn</h1>
      <p>Sắp ra mắt trên Google Play và App Store.</p>
    </main>
  </body>
</html>
