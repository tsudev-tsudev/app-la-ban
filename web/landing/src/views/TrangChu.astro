---
import DienThoai from '../components/DienThoai.astro';
import Icon from '../components/Icon.astro';
import Trang from '../layouts/Trang.astro';
import { DUONG_DAN, NOI_DUNG, type NgonNgu } from '../i18n/noi-dung';
import { napBanApk } from '../lib/apk';
import { svgVongDongTam } from '../../../../tools/build/vong-dong-tam.mjs';

interface Props {
  lang: NgonNgu;
}
const { lang } = Astro.props;
const t = NOI_DUNG[lang];
const c = t.chu;
const tai = DUONG_DAN.tai[lang];
const ban = await napBanApk();
// STD50 PR2: bố cục do-luong - mặt la bàn lớn ở giữa, số liệu phụ xếp hai bên; hoạ tiết vong-dong-tam tĩnh phía sau.
const hoaTiet = svgVongDongTam('currentColor');
const soTrai = c.soLieu.slice(0, 2);
const soPhai = c.soLieu.slice(2);
---
<Trang lang={lang} trang="chu">
  <section class="hero khung">
    <div class="hero-chu">
      <span class="nhan-nho"><span class="cham" aria-hidden="true"></span>{c.nhan}{ban && ` · v${ban.phienBan}`}</span>
      <h1>{c.tieuDe} <span class="nhan-mau">{c.tieuDeNhan}</span></h1>
      <p class="hero-mo">{c.moTa}</p>
      <div class="hang-nut">
        <a class="nut nut-chinh" href={tai}><Icon ten="ghim-gps" />{c.nutApk}</a>
        <span class="nut nut-tat" aria-disabled="true">{c.nutPlay}</span>
        <span class="nut nut-tat" aria-disabled="true">{c.nutIos}</span>
      </div>
      <p class="ghi-chu">{c.ghiChuBeta}</p>
    </div>
    <div class="do-luong" aria-label={c.soLieuNhan} role="group">
      <svg class="vong-dong-tam" viewBox="0 0 600 600" aria-hidden="true" set:html={hoaTiet} />
      <ul class="so-phu so-trai">
        {soTrai.map((s) => (<li><strong>{s.so}</strong><span>{s.nhan}</span></li>))}
      </ul>
      <div class="mat-chinh">
        <DienThoai lang={lang} />
      </div>
      <ul class="so-phu so-phai">
        {soPhai.map((s) => (<li><strong>{s.so}</strong><span>{s.nhan}</span></li>))}
      </ul>
    </div>
  </section>

  <section id="tinh-nang" class="vung khung">
    <div class="dau-vung">
      <h2>{c.tinhNangTieuDe}</h2>
      <p>{c.tinhNangMoTa}</p>
    </div>
    <div class="luoi">
      {
        c.tinhNang.map((f) => (
          <article class="the tinh-nang">
            <div class="the-dau">
              <span class="o-icon">
                <Icon ten={f.icon} />
              </span>
              {f.sapCo && <span class="sap-co">{c.sapCo}</span>}
            </div>
            <h3>{f.tieuDe}</h3>
            <p class="mo">{f.noiDung}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="vung vung-phu">
    <div class="khung chinh-xac">
      <div class="dau-vung">
        <h2>{c.chinhXacTieuDe}</h2>
        <p>{c.chinhXacMoTa}</p>
      </div>
      <ol class="cac-buoc">
        {
          c.chinhXac.map((m, i) => (
            <li>
              <span class="so-buoc" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{m.tieuDe}</h3>
                <p class="mo">{m.noiDung}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="bao-mat" class="vung khung">
    <div class="dau-vung">
      <h2>{c.baoMatTieuDe}</h2>
      <p>{c.baoMatMoTa}</p>
    </div>
    <div class="luoi luoi-2">
      {
        c.baoMat.map((m) => (
          <article class="the bao-mat">
            <span class="o-icon">
              <Icon ten={m.icon} />
            </span>
            <div>
              <h3>{m.tieuDe}</h3>
              <p class="mo">{m.noiDung}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="vung vung-phu">
    <div class="khung">
      <div class="dau-vung">
        <h2>{c.loTrinhTieuDe}</h2>
      </div>
      <ol class="lo-trinh">
        {
          c.loTrinh.map((m) => (
            <li class={`lt-${m.trangThai}`}>
              <span class="lt-moc">{m.moc}</span>
              <h3>{m.tieuDe}</h3>
              <p class="mo">{m.noiDung}</p>
              <span class="lt-trang-thai">{c.trangThaiLoTrinh[m.trangThai]}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="vung khung hoi-dap">
    <div class="dau-vung">
      <h2>{c.hoiDapTieuDe}</h2>
    </div>
    <div class="ds-hoi">
      {
        c.hoiDap.map((h) => (
          <details>
            <summary>{h.tieuDe}</summary>
            <p class="mo">{h.noiDung}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="khung cuoi-wrap">
    <div class="cuoi">
      <div>
        <h2>{c.cuoiTieuDe}</h2>
        <p>{c.cuoiMoTa}</p>
      </div>
      <a class="nut nut-sang" href={tai}>{c.nutApk}</a>
    </div>
  </section>
</Trang>

<style>
  .hero {
    display: grid;
    gap: clamp(32px, 6vw, 64px);
    padding-block: clamp(40px, 7vw, 88px) clamp(32px, 5vw, 64px);
    background: var(--nen-hero);
  }
  .hero-chu {
    display: grid;
    gap: var(--lb-space-lg);
    justify-items: center;
    text-align: center;
  }
  .hero-chu > * {
    min-width: 0;
  }
  h1 {
    font: var(--lb-type-display);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 600;
  }
  .nhan-mau {
    display: block;
    background: linear-gradient(90deg, var(--lb-color-gradient-start), var(--lb-color-gradient-end));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-mo {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--lb-color-text-muted);
    max-width: 40rem;
    margin-inline: auto;
  }
  .hang-nut {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--lb-space-sm);
  }
  .ghi-chu {
    font: var(--lb-type-body-small);
    color: var(--lb-color-text-muted);
  }
  .do-luong {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'mat mat'
      'trai phai';
    gap: var(--lb-space-lg) var(--lb-space-md);
    align-items: center;
    isolation: isolate;
  }
  @media (min-width: 840px) {
    .do-luong {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      grid-template-areas: 'trai mat phai';
      gap: var(--lb-space-xxl);
    }
  }
  .vong-dong-tam {
    position: absolute;
    z-index: -1;
    inset: 50% auto auto 50%;
    width: min(100%, 720px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    color: var(--lb-color-accent);
    opacity: 0.6;
    pointer-events: none;
  }
  .mat-chinh {
    grid-area: mat;
    justify-self: center;
  }
  .so-phu {
    display: grid;
    gap: var(--lb-space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .so-trai {
    grid-area: trai;
  }
  .so-phai {
    grid-area: phai;
  }
  @media (min-width: 840px) {
    .so-trai {
      justify-items: end;
      text-align: end;
    }
  }
  .so-phu li {
    display: grid;
    gap: 4px;
    max-width: 16rem;
    padding: var(--lb-space-md);
    border: 1px solid var(--lb-color-outline);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--lb-color-surface) 88%, transparent);
  }
  .so-phu strong {
    font: var(--lb-type-telemetry);
    font-family: var(--font-display);
    color: var(--lb-color-primary-deep);
    font-variant-numeric: tabular-nums;
  }
  .so-phu span {
    color: var(--lb-color-text-muted);
    font: var(--lb-type-body-small);
  }
  .tinh-nang {
    display: grid;
    gap: var(--lb-space-sm);
    align-content: start;
    transition: transform var(--lb-motion-normal) ease, box-shadow var(--lb-motion-normal) ease;
  }
  .tinh-nang:hover {
    transform: translateY(-3px);
  }
  .the-dau {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: var(--lb-space-xs);
  }
  .sap-co {
    padding: 2px 10px;
    border-radius: 999px;
    font: var(--lb-type-caption);
    color: var(--lb-color-primary-deep);
    border: 1px solid currentColor;
  }
  .cac-buoc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--lb-space-md);
  }
  @media (min-width: 840px) {
    .cac-buoc {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cac-buoc li {
    display: flex;
    gap: var(--lb-space-md);
    padding: var(--lb-space-lg);
    border-radius: var(--lb-radius-sm);
    background: var(--lb-color-surface-raised);
    border: var(--vien);
  }
  .cac-buoc h3 {
    margin-bottom: var(--lb-space-xxs);
  }
  .so-buoc {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--lb-color-primary-deep);
    color: var(--lb-color-on-primary-deep);
    font: var(--lb-type-label);
  }
  .luoi-2 {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
  }
  .bao-mat {
    display: flex;
    gap: var(--lb-space-md);
    align-items: start;
  }
  .bao-mat h3 {
    margin-bottom: var(--lb-space-xxs);
  }
  .lo-trinh {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--lb-space-md);
  }
  @media (min-width: 840px) {
    .lo-trinh {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .lo-trinh li {
    position: relative;
    display: grid;
    gap: var(--lb-space-xs);
    align-content: start;
    padding: var(--lb-space-lg);
    padding-top: calc(var(--lb-space-lg) + 6px);
    border-radius: var(--lb-radius-sm);
    background: var(--lb-color-surface-raised);
    border: var(--vien);
    overflow: hidden;
  }
  .lo-trinh li::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: var(--lb-color-outline);
  }
  .lo-trinh .lt-xong::before {
    background: var(--lb-color-success);
  }
  .lo-trinh .lt-dang::before {
    background: linear-gradient(90deg, var(--lb-color-gradient-start), var(--lb-color-gradient-end));
  }
  .lt-moc {
    font: var(--lb-type-caption);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--lb-color-text-muted);
  }
  .lt-trang-thai {
    margin-top: var(--lb-space-xs);
    font: var(--lb-type-label);
    color: var(--lb-color-primary-deep);
  }
  .lt-xong .lt-trang-thai {
    color: var(--lb-color-success-strong);
  }
  .lt-sau .lt-trang-thai {
    color: var(--lb-color-text-muted);
  }
  .ds-hoi {
    display: grid;
    gap: var(--lb-space-sm);
    max-width: 52rem;
  }
  details {
    border: var(--vien);
    border-radius: var(--lb-radius-md);
    background: var(--lb-color-surface-raised);
  }
  summary {
    cursor: pointer;
    padding: var(--lb-space-md) var(--lb-space-lg);
    font: var(--lb-type-label);
    font-size: 1rem;
    list-style-position: outside;
  }
  details p {
    padding: 0 var(--lb-space-lg) var(--lb-space-md);
  }
  .cuoi-wrap {
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .cuoi {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--lb-space-lg);
    padding: clamp(24px, 5vw, 48px);
    border-radius: var(--lb-radius-sm);
    border: 1px solid var(--lb-color-outline);
    background: var(--quang) no-repeat, var(--lb-color-surface);
    color: var(--lb-color-text);
  }
  .cuoi p {
    margin-top: var(--lb-space-xs);
  }
  .nut-sang {
    background: var(--nut-nen);
    color: var(--nut-chu);
  }
</style>
