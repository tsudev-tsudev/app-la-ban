---
// Khiếu nại hạn chế (S7c1): form gửi thẳng Worker /v1/khieu-nai, chống bot bằng Turnstile (siteverify ở Worker). Chưa có
// site key -> chỉ mailto điền sẵn mẫu như trước. Email luôn còn làm đường dự phòng (Turnstile bị chặn, không có JS).
import Icon from '../components/Icon.astro';
import Trang from '../layouts/Trang.astro';
import { NOI_DUNG, type NgonNgu } from '../i18n/noi-dung';
import { NGUON_TURNSTILE, TURNSTILE_SITE_KEY } from '../lib/khieu-nai';

interface Props {
  lang: NgonNgu;
}
const { lang } = Astro.props;
const t = NOI_DUNG[lang];
const k = t.khieu;
const f = k.form;
const coForm = TURNSTILE_SITE_KEY !== '';
const dataLoi = Object.fromEntries(Object.entries(f.loi).map(([ma, chu]) => [`data-loi-${ma}`, chu]));
const mailto = `mailto:security@tsudev.com?subject=${encodeURIComponent(k.chuDeEmail)}&body=${encodeURIComponent(k.thanEmail)}`;
---
<Trang lang={lang} trang="khieu">
  <section class="dau-trang khung">
    <h1>{t.trang.khieu.tieuDe.split(' - ')[0]}</h1>
    <p>{k.moTa}</p>
  </section>
  <section class="khung vung-kn">
    <ol class="buoc">
      {
        k.buoc.map((b, i) => (
          <li class="the">
            <span class="so" aria-hidden="true">{i + 1}</span>
            <div>
              <h2>{b.tieuDe}</h2>
              <p class="mo">{b.noiDung}</p>
            </div>
          </li>
        ))
      }
    </ol>
    {
      coForm && (
        <form class="the form-kn" data-khieu-nai data-site-key={TURNSTILE_SITE_KEY} data-dang-gui={f.dangGui} data-xong={f.xong} {...dataLoi}>
          <h2>{f.tieuDe}</h2>
          <label>
            <span>{f.ref}</span>
            <input name="ref" required minlength="10" maxlength="24" pattern="[A-Za-z0-9 \-]{10,24}" placeholder={f.refGoiY} autocomplete="off" autocapitalize="characters" spellcheck="false" />
          </label>
          <label>
            <span>{f.noiDung}</span>
            <textarea name="noiDung" required minlength="20" maxlength="2000" rows="6" placeholder={f.noiDungGoiY} />
          </label>
          <label>
            <span>{f.lienHe}</span>
            <input name="lienHe" type="email" maxlength="254" placeholder={f.lienHeGoiY} autocomplete="email" />
          </label>
          <div class="o-turnstile" data-o="turnstile" />
          <noscript><p class="mo">{f.canJs}</p></noscript>
          <button class="nut nut-chinh" type="submit" data-o="gui" data-gui={f.gui} data-dang-gui={f.dangGui}>{f.gui}</button>
          <p class="trang-thai-kn" data-o="trang-thai" role="status" aria-live="polite" hidden />
        </form>
      )
    }
    {coForm && <p class="mo">{f.hoacEmail}</p>}
    <a class:list={['nut', coForm ? 'nut-phu' : 'nut-chinh']} href={mailto}><Icon ten="chia-se-qr" />{k.nutEmail}</a>
    <p class="mo luu-y">{k.luuY}</p>
  </section>
</Trang>
{coForm && <script is:inline src={`${NGUON_TURNSTILE}/turnstile/v0/api.js?render=explicit`} defer />}
{coForm && <script is:inline src="/js/khieu-nai.js" defer />}

<style>
  .vung-kn {
    display: grid;
    gap: var(--lb-space-lg);
    justify-items: start;
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .buoc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--lb-space-md);
    width: 100%;
    max-width: 46rem;
  }
  .buoc li {
    display: flex;
    gap: var(--lb-space-md);
    align-items: start;
  }
  .buoc h2 {
    font: var(--lb-type-title);
    margin-bottom: 4px;
  }
  .so {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--lb-color-primary-deep);
    color: var(--lb-color-on-primary-deep);
    font: var(--lb-type-label);
  }
  .form-kn {
    display: grid;
    gap: var(--lb-space-md);
    width: 100%;
    max-width: 46rem;
  }
  .form-kn h2 {
    font: var(--lb-type-title);
  }
  .form-kn label {
    display: grid;
    gap: var(--lb-space-xs);
    font: var(--lb-type-label);
  }
  .form-kn input,
  .form-kn textarea {
    font: var(--lb-type-body);
    padding: var(--lb-space-sm) var(--lb-space-md);
    border-radius: var(--lb-radius-sm);
    border: 1px solid var(--lb-color-outline);
    background: var(--lb-color-surface);
    color: var(--lb-color-text);
    width: 100%;
    box-sizing: border-box;
  }
  .form-kn textarea {
    resize: vertical;
  }
  .form-kn .nut {
    justify-self: start;
  }
  .o-turnstile {
    min-height: 65px;
  }
  .trang-thai-kn {
    font: var(--lb-type-body-small);
    margin: 0;
  }
  .trang-thai-kn[data-loai='loi'] {
    color: var(--lb-color-danger-strong);
  }
  .trang-thai-kn[data-loai='xong'] {
    color: var(--lb-color-success-strong);
  }
  .luu-y {
    font: var(--lb-type-body-small);
    max-width: 46rem;
  }
</style>
