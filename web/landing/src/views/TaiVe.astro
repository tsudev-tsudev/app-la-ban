---
import QRCode from 'qrcode';
import Icon from '../components/Icon.astro';
import Trang from '../layouts/Trang.astro';
import { DUONG_DAN, NOI_DUNG, type NgonNgu } from '../i18n/noi-dung';
import { androidToiThieu, dinhDangCo, napBanApk } from '../lib/apk';

interface Props {
  lang: NgonNgu;
}
const { lang } = Astro.props;
const t = NOI_DUNG[lang];
const d = t.tai;
const ban = await napBanApk();
const urlTrang = new URL(DUONG_DAN.tai[lang], Astro.site ?? 'https://compass.tsudev.com').href;
// QR sinh lúc build (SVG thuần) -> mở trang tải trên điện thoại.
const qr = (await QRCode.toString(urlTrang, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#0B1220', light: '#FFFFFF' } })).replace(
  '<svg ',
  '<svg aria-hidden="true" focusable="false" ',
);
// Trình duyệt nội bộ của Zalo / Facebook... không tải được APK: intent mở Chrome (Android) cùng trang.
const intentChrome = `intent://${urlTrang.replace(/^https:\/\//, '')}#Intent;scheme=https;package=com.android.chrome;S.browser_fallback_url=${encodeURIComponent(urlTrang)};end`;
const ngay = ban ? new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-GB', { dateStyle: 'long' }).format(new Date(ban.ngay)) : '';
const tep = ban
  ? // Từ beta.8 mỗi ABI một APK (QUYET_DINH Q36); 'universal' còn để đọc latest.json của bản cũ hơn.
    (
      [
        ['arm64', d.banArm64, d.banArm64MoTa],
        ['armv7', d.banArmv7, d.banArmv7MoTa],
        ['universal', d.banUniversal, d.banUniversalMoTa],
      ] as const
    ).flatMap(([loai, tieuDe, moTa]) => {
      const f = ban.tep.find((x) => x.loai === loai);
      return f ? [{ ...f, tieuDe, moTa }] : [];
    })
  : [];
---
<Trang lang={lang} trang="tai">
  <section class="dau-trang khung">
    <span class="nhan-nho"><span class="cham" aria-hidden="true"></span>Android</span>
    <h1>{d.tieuDe}</h1>
    <p>{d.moTa}</p>
  </section>

  <section class="khung vung-tai">
    <div class="cot-chinh">
      <div id="trong-app" class="trong-app" role="alert" hidden>
        <strong>{d.trongAppTieuDe}</strong>
        <p>{d.trongAppMoTa}</p>
        <a class="nut nut-chinh" href={intentChrome}>{d.moChrome}</a>
      </div>
      {
        ban ? (
          <>
            <dl class="thong-tin the">
              <div>
                <dt>{d.phienBan}</dt>
                <dd>{ban.phienBan}</dd>
              </div>
              <div>
                <dt>{d.ngay}</dt>
                <dd>{ngay}</dd>
              </div>
              <div>
                <dt>{d.yeuCau}</dt>
                <dd>{androidToiThieu(ban.minSdk)}</dd>
              </div>
            </dl>
            {tep.map((f, i) => (
              <article class={i === 0 ? 'the ban ban-chinh' : 'the ban'}>
                <div class="ban-dau">
                  <div>
                    <h2>{f.tieuDe}</h2>
                    <p class="mo">{f.moTa}</p>
                  </div>
                  <a class={i === 0 ? 'nut nut-chinh' : 'nut nut-phu'} href={f.url}>
                    {d.nutTai} · {dinhDangCo(f.co, lang)}
                  </a>
                </div>
                <p class="sha">
                  <span>{d.sha}</span>
                  <code data-cho-chon>{f.sha256}</code>
                </p>
              </article>
            ))}
            <p class="chung-chi mo">
              {d.chungChi}: <code>{ban.chungChiSha256.match(/../g)?.join(':').toUpperCase()}</code>
            </p>
          </>
        ) : (
          <p class="the chua-co">{d.chuaCo}</p>
        )
      }
      <p class="canh-bao"><Icon ten="khien" /><span>{d.canhBao}</span></p>
    </div>

    <aside class="cot-phu">
      <div class="the qr">
        <Fragment set:html={qr} />
        <p class="mo">{d.quetQr}</p>
      </div>
      {
        d.nenTangKhac.map((n) => (
          <div class="the nen-tang">
            <h3>{n.tieuDe}</h3>
            <p class="mo">{n.noiDung}</p>
          </div>
        ))
      }
      {
        ban && (
          <div class="the nen-tang">
            <h3>GitHub</h3>
            <p class="mo">
              <a href={ban.github}>{d.github}</a>. {d.githubGhiChu}
            </p>
          </div>
        )
      }
    </aside>
  </section>

  <section class="vung vung-phu">
    <div class="khung">
      <div class="dau-vung">
        <h2>{d.caiTieuDe}</h2>
      </div>
      <ol class="buoc-cai">
        {
          d.buocCai.map((b, i) => (
            <li class="the">
              <span class="so" aria-hidden="true">{i + 1}</span>
              <h3>{b.tieuDe}</h3>
              <p class="mo">{b.noiDung}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="vung khung">
    <div class="van-ban">
      <section>
        <h2>{d.kiemTieuDe}</h2>
        <p>{d.kiemMoTa}</p>
        <pre class="lenh" data-cho-chon><code>{ban ? `sha256sum ${ban.tep[0]?.ten}` : 'sha256sum la-ban-<version>-arm64.apk'}
{'# Windows PowerShell'}
{ban ? `Get-FileHash ${ban.tep[0]?.ten}` : 'Get-FileHash la-ban-<version>-arm64.apk'}</code></pre>
      </section>
    </div>
  </section>
</Trang>

<script is:inline src="/js/trinh-duyet.js" defer></script>

<style>
  .trong-app {
    display: grid;
    gap: var(--lb-space-sm);
    justify-items: start;
    padding: var(--lb-space-lg);
    border-radius: var(--lb-radius-lg);
    border: 2px solid var(--lb-color-danger-strong);
    background: color-mix(in srgb, var(--lb-color-danger) 10%, var(--lb-color-surface-raised));
  }
  .trong-app[hidden] {
    display: none;
  }
  .trong-app strong {
    font: var(--lb-type-title);
  }
  .vung-tai {
    display: grid;
    gap: var(--lb-space-lg);
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  @media (min-width: 840px) {
    .vung-tai {
      grid-template-columns: 1fr 300px;
      align-items: start;
    }
  }
  .cot-chinh,
  .cot-phu {
    display: grid;
    gap: var(--lb-space-md);
    min-width: 0;
  }
  .thong-tin {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--lb-space-md);
    margin: 0;
  }
  .thong-tin dt {
    font: var(--lb-type-caption);
    color: var(--lb-color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .thong-tin dd {
    margin: 4px 0 0;
    font: var(--lb-type-title);
  }
  .ban {
    display: grid;
    gap: var(--lb-space-md);
  }
  .ban-chinh {
    border: 2px solid var(--lb-color-primary-deep);
    box-shadow: var(--lb-shadow-md);
  }
  .ban-dau {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--lb-space-md);
  }
  .ban-dau h2 {
    font: var(--lb-type-title);
    margin-bottom: 4px;
  }
  .sha {
    display: grid;
    gap: 4px;
    padding: var(--lb-space-sm);
    border-radius: var(--lb-radius-sm);
    background: var(--lb-color-surface);
    font: var(--lb-type-body-small);
  }
  .sha span {
    font: var(--lb-type-caption);
    color: var(--lb-color-text-muted);
  }
  .chung-chi {
    font: var(--lb-type-body-small);
  }
  .chua-co {
    font: var(--lb-type-title);
  }
  .canh-bao {
    display: flex;
    gap: var(--lb-space-sm);
    align-items: start;
    padding: var(--lb-space-md);
    border-radius: var(--lb-radius-md);
    border: 1px solid var(--lb-color-warning-strong);
    background: color-mix(in srgb, var(--lb-color-warning) 12%, transparent);
    font: var(--lb-type-body-small);
  }
  .canh-bao :global(svg) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--lb-color-warning-strong);
  }
  .qr {
    display: grid;
    gap: var(--lb-space-sm);
    justify-items: center;
    text-align: center;
  }
  .qr :global(svg) {
    width: 180px;
    height: 180px;
    border-radius: var(--lb-radius-sm);
  }
  .nen-tang {
    display: grid;
    gap: 4px;
  }
  .buoc-cai {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--lb-space-md);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .buoc-cai li {
    display: grid;
    gap: var(--lb-space-xs);
    align-content: start;
  }
  .so {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--lb-color-primary-deep);
    color: var(--lb-color-on-primary-deep);
    font: var(--lb-type-label);
  }
  .lenh {
    margin: 0;
    padding: var(--lb-space-md);
    border-radius: var(--lb-radius-md);
    background: #0b1220;
    color: #e8eef7;
    overflow-x: auto;
  }
</style>
