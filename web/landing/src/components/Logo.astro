---
// Logo ngang (design/logo). Q68: bản sáng / tối theo data-theme của <html> (mặc định Tối, đổi bằng bộ chọn ở chân trang),
// không theo prefers-color-scheme - CSS không hỏi hệ điều hành.
interface Props {
  rong?: number;
}
const { rong = 132 } = Astro.props;
const cao = Math.round((rong * 160) / 578);
---
<span class="logo">
  <img class="logo-toi" src="/logo-nen-toi.svg" alt="La bàn" width={rong} height={cao} />
  <img class="logo-sang" src="/logo.svg" alt="La bàn" width={rong} height={cao} />
</span>

<style>
  .logo {
    display: inline-block;
  }
  .logo-sang {
    display: none;
  }
  :global([data-theme='light']) .logo-sang {
    display: block;
  }
  :global([data-theme='light']) .logo-toi {
    display: none;
  }
</style>
